# MeraCare Go API — copy to apps/api/.env and fill in.
# Never commit real values. See docs/09-security-privacy.md.

# --- Server ---
PORT=8080
ENV=development
# debug | info | warn | error
LOG_LEVEL=debug
# Comma-separated origins allowed to call the API from a browser (future web app).
CORS_ALLOWED_ORIGINS=

# --- Database ---
# Local development (see docker-compose.yml):
DATABASE_URL=postgres://meracare:meracare@localhost:55432/meracare?sslmode=disable
# Supabase (Session/Transaction pooler connection string):
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_MAX_CONNS=10

# --- Supabase Auth ---
# Project URL, e.g. https://<project-ref>.supabase.co
# Required: it yields both the JWKS endpoint and the expected token issuer.
SUPABASE_URL=

# How access tokens are verified.
#
#   asymmetric   (default, recommended) Verify against the project's published
#                signing keys at <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
#                The API holds only public keys, so it can verify a token but
#                can never mint one. Leave SUPABASE_JWT_SECRET empty.
#
#   legacy_hs256 Verify with the project's shared JWT secret. The same secret
#                both verifies and signs, so anything holding it can forge a
#                token for any user. Only for projects still on the legacy
#                secret; migrate to asymmetric keys when you can.
SUPABASE_JWT_MODE=asymmetric

# Only for SUPABASE_JWT_MODE=legacy_hs256. Startup fails if this is set while
# the mode is asymmetric, so an unused forgeable key cannot linger unnoticed.
SUPABASE_JWT_SECRET=

# Expected `aud` claim on Supabase access tokens.
SUPABASE_JWT_AUDIENCE=authenticated
# Allowed clock skew when validating exp/nbf/iat.
SUPABASE_JWT_LEEWAY=30s
